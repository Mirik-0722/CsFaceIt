{
  "name": "POST /steam/openid/login (the fake Steam confirms every answer)",
  "request": {
    "method": "POST",
    "urlPath": "/steam/openid/login",
    "bodyPatterns": [
      {
        "contains": "openid.mode=check_authentication"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/plain;charset=utf-8"
    },
    "body": "ns:http://specs.openid.net/auth/2.0\nis_valid:true\n"
  }
}
