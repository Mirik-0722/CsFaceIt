{
  "name": "POST /download/v2/demos/download for the missing demo",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/download/v2/demos/download",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer fake-downloads-token"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.resource_url",
          "equalTo": "http://fake-faceit:8080/demos/missing.dem"
        }
      }
    ]
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "errors": [
        {
          "message": "Resource not found",
          "code": "err_nf0",
          "http_status": 404,
          "parameters": []
        }
      ]
    }
  }
}
