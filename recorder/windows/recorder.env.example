# The settings of the recorder on the Windows machine (recorder\README.md, "Windows (real recording)").
# Copy this file to C:\csfaceit\recorder.env, fill it in, and give that path to windows\install.ps1.
# One KEY=value per line, no quotes and no spaces around "=". A value may not hold a "#".

# Where the site is. A Windows PC on the same network as the Mac that runs the stack: the Mac's own address on that
# network and the web port, such as http://192.168.1.20:3000. The site on a server: https://your-domain.
BACKEND_URL=http://192.168.1.20:3000

# The secret of the recorder: exactly the value of CLIP_WORKER_TOKEN in the .env of the stack.
CLIP_WORKER_TOKEN=

RECORDER_MODE=csdm
# The recorder's name on the site: letters, digits, ".", "_" and "-".
WORKER_NAME=windows-1
# Where the demos and the scratch of a clip are kept: a folder without spaces, "#" or letters outside English.
WORK_DIR=C:\csfaceit\work
QUALITIES=720p,1080p

# Optional. Without them the defaults below hold (<you> is the Windows user).
# CSDM_PATH=C:\Users\<you>\AppData\Local\Programs\cs-demo-manager\csdm.cmd
# CS2_PATH=C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive
# CSDM_MIN_TIMEOUT_SECONDS=600
# CSDM_TIMEOUT_FACTOR=6
# CSDM_PLAYBACK_START_SECONDS=180
# FFMPEG_PATH=C:\Users\<you>\.csdm\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\Users\<you>\.csdm\ffmpeg\bin\ffprobe.exe
# ERROR_BACKOFF_SECONDS=300
