# Copy to .env and fill in the secrets. Never commit .env.
#
# The connection settings below suit running the backend on the host (dev mode). With `docker compose up` the
# backend container ignores DB_URL, REDIS_HOST, REDIS_PORT, RABBITMQ_HOST, RABBITMQ_PORT, STORAGE_TYPE, STORAGE_LOCAL_DIR,
# MINIO_ENDPOINT and CORS_ALLOWED_ORIGINS: compose points it at the postgres, redis, rabbitmq and minio services and
# allows the origin http://localhost:${WEB_PORT}.
DB_URL=jdbc:postgresql://localhost:5432/csfaceit
DB_USER=csfaceit
DB_PASSWORD=csfaceit
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# RabbitMQ credentials: the rabbitmq service is created with them and the backend logs in with them. The guest defaults
# are fine because compose publishes the broker on 127.0.0.1 only; choose your own before exposing it anywhere else.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Where the demo files are kept: "local" (files under STORAGE_LOCAL_DIR, relative to the backend's working directory)
# or "minio" (an S3-compatible server). Compose always runs the backend with "minio".
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/storage
MINIO_ENDPOINT=http://localhost:9000
# MinIO credentials: the minio service is created with them and the backend logs in with them. The minioadmin defaults
# are fine because compose publishes MinIO on 127.0.0.1 only; choose your own before exposing it anywhere else.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Bucket the demo files go to; the backend creates it when it is missing.
MINIO_BUCKET=csfaceit
# MinIO server image of the compose stack (minio/minio is no longer published on Docker Hub). The default is the
# community build alpine/minio, pinned by tag and digest:
# MINIO_IMAGE=alpine/minio:RELEASE.2025-10-15T17-29-55Z@sha256:cf23643a6cf9ce159c57643ceb88279e431262282428c9e0bf3a7ef1a97e84b4
# The most a manual demo upload (POST /api/v1/matches/{id}/demo/upload) may be: a size with a unit, such as 1GB or 512MB.
# The Nginx of the compose stack accepts 1 GB for that path (frontend/nginx.conf); raise both to allow more.
DEMO_UPLOAD_MAX_SIZE=1GB
# Stored demo files older than this many days are deleted once a day (DemoRetentionJob); the parsed facts stay in the
# database and the demo keeps its status. 0 keeps the files forever.
DEMO_RETENTION_DAYS=30
# When that clean-up runs: Spring's six cron fields (second minute hour day month weekday), server time. Normally left alone.
# Keep the quotes: the value has spaces and asterisks, and `set -a && source .env` would split and expand it without them.
# DEMO_RETENTION_CRON="0 0 4 * * *"
# The most a demo may be once the parser has decompressed it, in bytes (default 2147483648, 2 GiB). A larger demo is
# marked FAILED as too large instead of being parsed.
PARSER_MAX_DEMO_BYTES=2147483648
# Secrets: leave empty here, set real values only in your local .env. Both are required:
# the backend refuses to start without FACEIT_API_KEY, and without APP_API_KEY every protected request is rejected.
FACEIT_API_KEY=
APP_API_KEY=
# Password of the Grafana admin user (user name: admin). Needed only for `docker compose --profile observability up`,
# which starts Prometheus and Grafana; there is no default, and the grafana service stops with a message while it is
# empty. Choose your own, for example `openssl rand -hex 16`.
GRAFANA_ADMIN_PASSWORD=
# FACEIT Data API address; override it only to point the backend at a fake FACEIT.
# FACEIT_BASE_URL=https://open.faceit.com/data/v4
# How far back a player's match history reaches (FACEIT answers only the last month unless asked for more).
# FACEIT_HISTORY_LOOKBACK=365d
# Origins allowed to call the API from a browser (dev mode: the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Host port the compose stack serves the web UI on.
WEB_PORT=3000
